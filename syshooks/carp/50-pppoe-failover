#!/bin/sh
# 50-pppoe-failover - OPNsense CARP syshook for the SECONDARY node.
#
# The WAN here is PPPoE assigned directly to an interface (there is NO WAN CARP
# VIP), so the stock 20-ppp syshook never fires for this design. This hook acts
# on the LAN CARP VIP instead:
#
#   LAN -> MASTER      : (re)dial PPPoE on $WAN_IF, then spawn a detached
#                        recovery tracker that pings 1.1.1.1 every 2 s and
#                        records the total unattended recovery delay in $LOG.
#   LAN -> BACKUP/INIT : suspend the WAN dialer so the current master keeps the
#                        single ISP-permitted PPPoE session.
#
# rc.syshook invokes this with: $1 = <vhid>@<iface>   $2 = MASTER|BACKUP|INIT
#
# Deploy on the SECONDARY only:
#   install -m 0755 50-pppoe-failover /usr/local/etc/rc.syshook.d/carp/50-pppoe-failover
# Idempotent, kills nothing on the peer, and survives OPNsense upgrades because
# it lives in the user hook directory rather than a stock file.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

LOG=/var/log/pppoe_failover.log
TRACK_PID=/var/run/pppoe_failover.tracker.pid
WAN_IF=wan
LAN_VHID=1
PING_TARGET=1.1.1.1

SUBSYS="${1:-}"
TYPE="${2:-}"
VHID="${SUBSYS%@*}"
IFACE="${SUBSYS#*@}"

log() {
    printf '%s [failover] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >> "${LOG}"
}

# Detached recovery tracker: measure how long the WAN takes to come back.
track() {
    started=$(date +%s)
    while :; do
        if ping -c 1 -t 2 "${PING_TARGET}" >/dev/null 2>&1; then
            log "WAN reachable again after $(( $(date +%s) - started ))s unattended"
            return 0
        fi
        sleep 2
    done
}

start_tracker() {
    if [ -f "${TRACK_PID}" ] && kill -0 "$(cat "${TRACK_PID}" 2>/dev/null)" 2>/dev/null; then
        log "recovery tracker already running (pid $(cat "${TRACK_PID}"))"
        return 0
    fi
    ( track ) &
    echo $! > "${TRACK_PID}"
}

# Only the LAN VIP drives WAN ownership in this design.
[ "${VHID}" = "${LAN_VHID}" ] || exit 0

case "${TYPE}" in
    MASTER)
        log "LAN ${IFACE} -> MASTER: dialing PPPoE on ${WAN_IF}"
        configctl interface reconfigure "${WAN_IF}" >>"${LOG}" 2>&1
        start_tracker
        ;;
    BACKUP|INIT)
        wan_dev=$(ifconfig -l 2>/dev/null | tr ' ' '\n' | grep -m1 '^pppoe')
        if [ -n "${wan_dev}" ]; then
            log "LAN ${IFACE} -> ${TYPE}: suspending WAN (${wan_dev})"
            configctl interface linkup.stop "${wan_dev}" >>"${LOG}" 2>&1
        else
            log "LAN ${IFACE} -> ${TYPE}: no PPPoE device present, nothing to suspend"
        fi
        ;;
    *)
        log "unexpected CARP type '${TYPE}' for ${SUBSYS}"
        exit 1
        ;;
esac

exit 0
